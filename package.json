{
  "name": "agent-workflow-platform",
  "version": "0.0.1",
  "private": true,
  "description": "Agent-native workflow runtime for professional services. Workflows are Claude agent loops, not DAGs.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "dev:worker": "pnpm --filter api worker",
    "dev:triggers": "pnpm --filter api triggers",
    "evals": "pnpm --filter evals run",
    "db:migrate": "psql \"$DATABASE_URL\" -f db/schema.sql",
    "pack:install": "tsx scripts/install-pack.ts",
    "verify": "tsx scripts/verify.ts",
    "test:e2e": "pnpm --filter web test:e2e"
  },
  "dependencies": {
    "runtime": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "@types/node": "^22.9.0"
  }
}
